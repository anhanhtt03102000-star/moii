/* Biến hệ thống (CSS Variables) */
:root {
  --primary-color: #2563eb;
  --bg-color: #ffffff;
  --text-color: #1f2937;
  --font-main: 'Inter', sans-serif;
}

/* Reset CSS & Base Styles */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-main);
  background-color: var(--bg-color);
  color: var(--text-color);
  line-height: 1.6;
}

